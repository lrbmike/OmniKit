# Database Configuration
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:../data/omnikit.db"
# PostgreSQL 示例（请替换为真实值，并将 DATABASE_PROVIDER 改为 postgresql）
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://db_user:db_password@db.example.com:5432/omnikit?schema=public"
# Supabase 示例（DATABASE_URL 使用 Pooler 地址，DIRECT_URL 使用直连地址）
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET="omnikit_dev_session_secret_2026_32chars"

# Node Environment
NODE_ENV="development"
